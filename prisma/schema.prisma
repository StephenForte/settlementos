generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entity {
  id                String   @id @default(cuid())
  externalId        String   @unique
  name              String
  type              String   @default("BUSINESS")
  country           String
  role              String   @default("BOTH") // SENDER | RECIPIENT | BOTH
  kybStatus         String   @default("PENDING") // PASSED | PENDING | FAILED
  riskRating        String   @default("LOW") // LOW | MEDIUM | HIGH
  approvedCorridors String   @default("[]") // JSON array of "USD-JPY" style corridor codes
  mmfEligible       Boolean  @default(false) // institutional-only gate for tokenized-MMF parking
  mmfOptIn          Boolean  @default(false) // explicit opt-in; both must be true to park
  createdAt         DateTime @default(now())

  wallets          Wallet[]
  paymentsSent     Payment[]      @relation("sender")
  paymentsReceived Payment[]      @relation("recipient")
  ledgerCredits    LedgerCredit[]
  apiKeys          ApiKey[]
}

// API-key identity for API callers. Only the sha256 hash of a key is stored —
// the raw key exists at seed time and in the caller's hands, never in the DB.
model ApiKey {
  id        String   @id @default(cuid())
  keyHash   String   @unique // sha256 hex of the raw key
  role      String // OPERATOR | REVIEWER | ENTITY
  entityId  String? // required when role = ENTITY; null otherwise
  label     String   @default("")
  createdAt DateTime @default(now())

  entity Entity? @relation(fields: [entityId], references: [id])
}

model Wallet {
  id          String   @id @default(cuid())
  entityId    String
  address     String
  network     String   @default("base-local")
  label       String   @default("")
  allowlisted Boolean  @default(false)
  riskScore   Int      @default(0) // 0-100, mock wallet screening score
  createdAt   DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@unique([address, network])
}

model Payment {
  id                  String   @id
  status              String   @default("DRAFT")
  senderId            String
  recipientId         String
  amount              String // decimal string in source currency units
  sourceCurrency      String
  destinationCurrency String
  sourceAsset         String
  destinationAsset    String
  sourceNetwork       String   @default("base-local")
  destinationNetwork  String   @default("base-local")
  purpose             String   @default("")
  referenceId         String   @default("")
  memo                String   @default("")
  quoteJson           String? // JSON array of route options
  selectedRouteId     String?
  fxRate              String?
  destinationAmount   String?
  feeJson             String? // JSON fee breakdown
  onchainPaymentId    String? // bytes32 id used on the settlement contract
  txHash              String? // initiate/escrow tx on source network
  settleTxHash        String? // settlement/release tx on source network
  destinationTxHash   String? // bridge payout tx on destination network (cross-chain routes)
  compensationTxHash  String? // treasury→sender make-good tx on source network (destination leg failed post-settlement)
  failureReason       String?
  executionLeaseId    String? // held for the duration of one execution attempt; NULL = executable
  leasedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sender    Entity @relation("sender", fields: [senderId], references: [id])
  recipient Entity @relation("recipient", fields: [recipientId], references: [id])

  complianceChecks ComplianceCheck[]
  auditEvents      AuditEvent[]
  ledgerCredits    LedgerCredit[]
  reservation      LiquidityReservation?
}

model ComplianceCheck {
  id          String   @id @default(cuid())
  paymentId   String
  provider    String
  checkType   String // KYB_SENDER | KYC_RECIPIENT | SANCTIONS | WALLET_RISK | TX_RISK | CORRIDOR_RISK
  status      String // PASS | FAIL | MANUAL_REVIEW | EXEMPT_TESTNET
  score       Int      @default(0)
  reasonCodes String   @default("[]")
  rawResponse String? // verbatim provider response (JSON) — audit evidence; null for mocks
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// Append-only, hash-chained audit log. Each event's hash covers its content plus
// the previous event's hash, so tampering is detectable.
model AuditEvent {
  id        Int      @id @default(autoincrement())
  paymentId String?
  actor     String   @default("system")
  action    String
  detail    String   @default("{}")
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])
}

// A signed anchor over the audit chain: chainHash is the tip event's hash (which
// covers every event before it), signed with a key the database does not hold.
// Someone with DB write access can re-hash the whole log, but cannot re-sign it.
// No FK to AuditEvent on purpose — the log is append-only, so a dangling anchor
// means events were deleted, and reporting that is the point.
model AuditCheckpoint {
  id          Int      @id @default(autoincrement())
  lastEventId Int
  chainHash   String
  signature   String // HMAC-SHA256("<lastEventId>|<chainHash>", AUDIT_ANCHOR_KEY)
  createdAt   DateTime @default(now())
}

// Simulated fiat payout leg: recipient's local-currency ledger balance.
model LedgerCredit {
  id        String   @id @default(cuid())
  paymentId String
  entityId  String
  currency  String
  amount    String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
  entity  Entity  @relation(fields: [entityId], references: [id])
}

// A parked treasury position in the tokenized MMF. Append-only history: recall
// flips status and stamps the recall tx, it never deletes the row. Current value
// is always derived (shares x live contract index), never stored here.
model TreasuryPosition {
  id            String    @id @default(cuid())
  network       String // network id, e.g. "base-local"
  asset         String // token symbol, e.g. "mockUSDC"
  shares        String // MMF shares, base units (decimal string of a bigint)
  assetAmountIn String // asset parked at entry, base units
  indexAtEntry  String // MMF share index at entry, 1e18-scaled
  status        String    @default("ACTIVE") // ACTIVE | RECALLED
  txHashPark    String
  txHashRecall  String?
  createdAt     DateTime  @default(now())
  recalledAt    DateTime?
}

// Safe retries for write endpoints. One row per (principal, Idempotency-Key):
// the row is created as a *reservation* before the handler runs and stamped with
// the response afterwards, so a duplicate that arrives mid-flight finds the
// reservation instead of racing the original. Rows are reclaimed in place once
// they age out (no cron — expiry is checked when the key is next presented).
//
// principalId is an ApiKey.id and deliberately carries no FK: reseeding keys
// (npm run setup) drops the ApiKey rows, and an orphaned record is harmless —
// its key can never be presented again.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  principalId    String
  key            String // the raw Idempotency-Key header value
  route          String // concrete path, e.g. "POST /api/payments/pay_x/execute"
  requestHash    String // sha256 of the canonical JSON body
  responseStatus Int? // null while the request is still in flight
  responseBody   String?
  createdAt      DateTime @default(now())

  @@unique([principalId, key])
}

model LiquidityReservation {
  id        String   @id @default(cuid())
  paymentId String   @unique
  asset     String
  network   String
  amount    String
  status    String   @default("RESERVED") // RESERVED | CONSUMED | RELEASED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}
