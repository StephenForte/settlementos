# SettlementOS environment. Copy to .env (gitignored) — never commit real keys.
# Everything here is optional except DATABASE_URL; unset vars fall back to the
# defaults noted below (local demo works with just DATABASE_URL).
#
# Render inventory (see tasks/runbooks/render-deploy.md):
#   DATABASE_URL              — secret — Postgres with ?schema=settlementos
#   AUDIT_ANCHOR_KEY          — secret — required on Render (anchored: true)
#   DEPLOYER_PRIVATE_KEY      — secret — operator signer (overlay privateKeyEnv)
#   BASE_SEPOLIA_RPC_URL      — public default ok; override if using a private RPC
#   FORTEL2_SEPOLIA_RPC_URL   — Render: https://fortel2-write.ente.ltd (Access)
#   FORTEL2_SEPOLIA_READ_RPC_URL — Render: http://fortel2-replica:10000 (no Access)
#   CF_ACCESS_CLIENT_ID       — secret — Access service token (Render only)
#   CF_ACCESS_CLIENT_SECRET   — secret — Access service token (Render only)
#   SETTLEMENTOS_CHAIN_DIR    — /etc/secrets on Render (Secret File mount)
#   TRUSTED_PROXY_HOPS        — "1" on Render
#   Secret File                 deployments.base-sepolia.json → /etc/secrets/…
# `npm run setup` is localhost-only (wipes DB). On Render use `npm run seed:demo`.

# Postgres. Tables live in the `settlementos` schema (NOT public) so this URL can
# point at a shared instance without colliding with other apps (e.g. chainbank in
# public.*). Local example — replace USER; never commit a real password or host:
#   postgresql://USER@127.0.0.1:5432/settlementos_dev?schema=settlementos
# Deployed (Render) shape — placeholder only:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=settlementos
# `npm run setup` refuses any host other than localhost / 127.0.0.1.
DATABASE_URL="postgresql://USER@127.0.0.1:5432/settlementos_dev?schema=settlementos"

# ── Local Hardhat chains (defaults shown) ────────────────────────────────────
# BASE_LOCAL_RPC_URL=http://127.0.0.1:8545
# POLYGON_LOCAL_RPC_URL=http://127.0.0.1:8546

# ── Real public testnets (defaults: public RPCs) ─────────────────────────────
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Funded deployer/operator key for npm run deploy:base-sepolia / deploy:polygon-amoy.
# Testnet-only key — never a mainnet key, never committed.
# DEPLOYER_PRIVATE_KEY=

# ── ForteL2 (OP Stack rail, operated OUTSIDE this repo) ──────────────────────
# Chain facts come from ForteL2 deployments/rail-interface.json.
# Write RPC — local default is the Mac sequencer loopback. On Render, the
# Cloudflare Access hostname (never VITE_*; never commit the token; do not
# publish this URL in ForteL2 rail-interface.json).
# FORTEL2_SEPOLIA_RPC_URL=http://127.0.0.1:9545
# FORTEL2_SEPOLIA_RPC_URL=https://fortel2-write.ente.ltd
# Access service token for the write hostname. Both required to attach
# CF-Access-Client-Id / CF-Access-Client-Secret on write clients; either
# missing → no headers (local loopback still works). Render only.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Optional read-only ForteL2 replica (Render private network only — not public).
# On Render Oregon: http://fortel2-replica:10000 (Private Service fortel2-replica).
# Read-only (writes rejected by the replica filter). ~3 min lag vs the sequencer
# (L1 batching) — confirm() and settlement must stay on FORTEL2_SEPOLIA_RPC_URL.
# Never point this at ente.ltd — the replica has no Access in front.
# Leave unset locally unless you tunnel to the replica; unset ⇒ reads use the
# sequencer (fail closed, never another chain).
# FORTEL2_SEPOLIA_READ_RPC_URL=http://fortel2-replica:10000
# Optional offline ForteL2 devnet (chain 901, resets freely).
# FORTEL2_LOCAL_RPC_URL=http://127.0.0.1:9545

# ── Compliance providers (mocks run when unset) ──────────────────────────────
# OPENSANCTIONS_API_KEY=
# CHAINALYSIS_ORACLE_RPC_URL=https://ethereum-rpc.publicnode.com
# CHAINALYSIS_ORACLE_ADDRESS=
# COMPLIANCE_PROVIDER_TIMEOUT_MS=

# ── Audit anchoring ──────────────────────────────────────────────────────────
# REQUIRED on Render (secret). Unset ⇒ no checkpoints and verifyAuditChain()
# reports anchored: false (still INTACT, but the weaker claim — the UI says so).
# Generate once (e.g. openssl rand -hex 32) and store only in the host env.
# AUDIT_ANCHOR_KEY=
# AUDIT_CHECKPOINT_INTERVAL=100

# ── Deployed overlay path (Render Secret Files) ──────────────────────────────
# Local default is ./chain. On Render set to /etc/secrets so loadDeployments()
# reads the dashboard-uploaded deployments.<network>.json (contains keys —
# never commit). lib/chain also falls back to /etc/secrets when CHAIN_DIR misses
# an overlay. Optional test override: SETTLEMENTOS_SECRET_OVERLAY_DIR.
# SETTLEMENTOS_CHAIN_DIR=/etc/secrets

# ── Web hardening ─────────────────────────────────────────────────────────────
# RATE_LIMIT_WRITES_PER_MINUTE=30
# On Render (one reverse proxy): TRUSTED_PROXY_HOPS=1
# TRUSTED_PROXY_HOPS=

# ── Treasury MMF ─────────────────────────────────────────────────────────────
# MMF_ANNUAL_RATE_BPS=350
