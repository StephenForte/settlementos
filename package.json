{
  "name": "settlementos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "chain": "hardhat node --config hardhat.config.cjs",
    "chain:polygon": "hardhat node --config hardhat.config.polygon.cjs --port 8546",
    "compile": "hardhat compile --config hardhat.config.cjs",
    "setup": "npm run compile && prisma generate && prisma db push && node scripts/setup.mjs",
    "deploy:base-sepolia": "npm run compile && node --env-file=.env scripts/deploy-testnet.mjs base-sepolia",
    "deploy:polygon-amoy": "npm run compile && node --env-file=.env scripts/deploy-testnet.mjs polygon-amoy",
    "deploy:fortel2-sepolia": "npm run compile && node --env-file=.env scripts/deploy-testnet.mjs fortel2-sepolia",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.2.11",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "hardhat": "^2.28.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.12"
  }
}
